# ── 依赖 ────────────────────────────────────────────────
node_modules/

# ── 构建产物 ────────────────────────────────────────────
# dist 与 src-tauri/target 是构建产物；把它们排除掉不只是洁癖：
# Tailwind 4 靠 .gitignore 判断哪些文件不参与类名扫描，
# 不排除的话 dist 里旧 CSS/JS 会被当成源码扫一遍，
# 构建时间从 4 秒涨到 30 秒，产出的 CSS 还会凭空变胖。
dist/
src-tauri/target/

# ── 工具缓存 ────────────────────────────────────────────
.cargo/
.npm-cache/

# 界面字体的**源**字体（Noto Sans SC 那个可变字体有 17 MB）不入库：
# 要发布的是 tools/build-fonts.py 生成的 src/assets/fonts/*.woff 子集。
tools/fonts-src/

# ── pdfjs 运行时资源 ────────────────────────────────────
# 构建时从 node_modules/pdfjs-dist 拷进来，不入库。
public/pdfjs/

# ── 测试 / 工具的临时输出 ───────────────────────────────
tmp/
out/

# 注意：**不要**排除 src/assets/fonts/ —— 界面字体子集必须随包发布。
